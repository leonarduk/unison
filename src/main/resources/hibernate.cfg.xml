<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.connection.driver_class">
            org.hsqldb.jdbcDriver
        </property>
        <property name="hibernate.connection.url">
            jdbc:hsqldb:file:unison-data/db;shutdown=true
        </property>
        <property name="hibernate.connection.username">SA</property>
        <property name="hibernate.dialect">
            org.hibernate.dialect.HSQLDialect
        </property>

        <property name="hibernate.cache.use_query_cache">false</property>
        <property name="hibernate.cache.use_second_level_cache">
            false
        </property>

        <!-- JDBC connection pool (use the built-in) -->
        <property name="hibernate.connection.pool_size">20</property>

        <!-- Update the schema in place, preserving existing data -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Echo all executed SQL to stdout -->
        <property name="hibernate.show_sql">false</property>
        <mapping resource="dao/Topic.hbm.xml"/>
        <mapping resource="dao/NewsGroup.hbm.xml"/>
        <mapping resource="dao/Message.hbm.xml"/>
        <mapping class="uk.co.sleonard.unison.datahandling.DAO.UsenetUser"/>
        <mapping resource="dao/Location.hbm.xml"/>
        <mapping resource="dao/IpAddress.hbm.xml"/>

    </session-factory>
</hibernate-configuration>
